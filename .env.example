NODE_ENV=development

API_PORT=4000
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://marketpilot:marketpilot@localhost:5432/marketpilot?schema=public
# REDIS_URL=  (uncomment when Redis is added) redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Google sign-in (optional). Create an OAuth client of type "Web application" in Google Cloud Console
# and add GOOGLE_REDIRECT_URI as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/auth/google/callback

# OpenRouter: structured extraction and embeddings (see docs/adr/0004). Leave the key empty to skip AI steps.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_EXTRACT=anthropic/claude-haiku-5.5
OPENROUTER_MODEL_EMBED=openai/text-embedding-3-large
OPENROUTER_PRIVACY=strict
# Competitor discovery (see docs/adr/0007): the model that reads each web search, and the search engine.
# "native" needs an OpenRouter account without enforced zero data retention, which ADR 0004 does not allow.
OPENROUTER_MODEL_SEARCH=anthropic/claude-haiku-5.5
OPENROUTER_SEARCH_ENGINE=exa
# Image generation (see docs/adr/0008): models tried in order, the next only if the previous fails.
OPENROUTER_MODEL_IMAGE=google/gemini-nano-banana-2.1,google/gemini-3.1-flash-image,google/gemini-3-pro-image
# Images one workspace may create per 24 hours, a spend guard until credits exist.
STUDIO_DAILY_IMAGE_LIMIT=40
# Reel portraits and keyframes one workspace may draw per 24 hours.
STUDIO_DAILY_REEL_IMAGE_LIMIT=60
# Seconds of reel video one workspace may render per 24 hours.
STUDIO_DAILY_REEL_VIDEO_SECONDS=120
# Video clips (ADR 0011): route:model entries tried in order.
VIDEO_MODELS=openrouter:kwaivgi/kling-v3.0-std,openrouter:alibaba/wan-3.0,higgsfield:kling-video/v3.0/std/image-to-video,higgsfield:bytedance/seedance-2.5/image-to-video
# Reel music (ADR 0013), through OpenRouter.
OPENROUTER_MODEL_MUSIC=google/lyria-3-clip-preview
# Reel voiceover (ADR 0013): Sarvam Bulbul. Empty means reels get music only.
SARVAM_API_KEY=
# Fallback video route, as the Higgsfield console copies it: keyId:secret
HIGGSFIELD_API_KEY=
# Reel assembly (ADR 0012): caption font folder, relative to apps/api, and whether this
# instance assembles reels (set false on API instances once a worker does it).
REEL_FONT_DIR=assets/fonts
REEL_ASSEMBLY_ENABLED=true

# Cloudinary: owner-uploaded and generated images (see docs/adr/0006 and 0008). Copy "API environment
# variable" from the Cloudinary console. Leave empty to turn image upload and generation off.
CLOUDINARY_URL=
