// Copilot conversations and agent runs (docs/COPILOT_AGENT.md section 9). Owned by modules/agents.

enum CopilotRole {
  user
  assistant
}

enum AgentRunStatus {
  running
  awaiting_approval
  completed
  failed
  cancelled
}

enum ToolCallStatus {
  ok
  error
  denied
}

enum PendingActionStatus {
  pending
  approved
  rejected
  executed
  failed
}

// One chat thread, private to the user who started it. Kept until the retention job ships
// (owner decision 2026-11-17); that job will key on `last_activity_at`.
model Conversation {
  id               String   @id @default(uuid(7)) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  brandId          String   @map("brand_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  title            String?
  // Rolling summary of every message up to and including `summary_through_id`.
  summary          String?
  summaryThroughId String?  @map("summary_through_id") @db.Uuid
  lastActivityAt   DateTime @default(now()) @map("last_activity_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  brand    Brand            @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages CopilotMessage[]
  runs     AgentRun[]

  @@index([workspaceId, userId, lastActivityAt])
  @@index([lastActivityAt])
  @@map("conversation")
}

// Append-only. Tool steps live in `tool_call`; only what the owner saw is here.
model CopilotMessage {
  id               String      @id @default(uuid(7)) @db.Uuid
  workspaceId      String      @map("workspace_id") @db.Uuid
  conversationId   String      @map("conversation_id") @db.Uuid
  runId            String?     @map("run_id") @db.Uuid
  role             CopilotRole
  content          String
  blocks           Json        @default("[]")
  promptTokens     Int?        @map("prompt_tokens")
  completionTokens Int?        @map("completion_tokens")
  createdAt        DateTime    @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([workspaceId])
  @@map("message")
}

// One per user turn, and the LangGraph thread for that turn.
model AgentRun {
  id               String         @id @default(uuid(7)) @db.Uuid
  workspaceId      String         @map("workspace_id") @db.Uuid
  conversationId   String         @map("conversation_id") @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  status           AgentRunStatus @default(running)
  // Client-supplied, so a retried send does not start a second run.
  idempotencyKey   String?        @map("idempotency_key")
  steps            Int            @default(0)
  promptTokens     Int            @default(0) @map("prompt_tokens")
  completionTokens Int            @default(0) @map("completion_tokens")
  costUsd          Float          @default(0) @map("cost_usd")
  models           String[]       @default([])
  page             Json?
  traceId          String?        @map("trace_id")
  error            String?
  startedAt        DateTime       @default(now()) @map("started_at")
  finishedAt       DateTime?      @map("finished_at")

  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  checkpoints    AgentCheckpoint[]
  writes         AgentCheckpointWrite[]
  toolCalls      ToolCall[]
  pendingActions PendingAction[]

  @@unique([conversationId, idempotencyKey])
  @@index([workspaceId, status])
  @@map("agent_run")
}

// LangGraph checkpoints, serialised by the library's serde (ADR 0005).
model AgentCheckpoint {
  id                 String   @id @default(uuid(7)) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  runId              String   @map("run_id") @db.Uuid
  namespace          String   @default("")
  checkpointId       String   @map("checkpoint_id")
  parentCheckpointId String?  @map("parent_checkpoint_id")
  checkpointType     String   @map("checkpoint_type")
  checkpoint         Bytes
  metadataType       String   @map("metadata_type")
  metadata           Bytes
  createdAt          DateTime @default(now()) @map("created_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, namespace, checkpointId])
  @@index([workspaceId])
  @@map("agent_checkpoint")
}

// Writes a task made against a checkpoint before the next one was saved.
model AgentCheckpointWrite {
  id           String @id @default(uuid(7)) @db.Uuid
  workspaceId  String @map("workspace_id") @db.Uuid
  runId        String @map("run_id") @db.Uuid
  namespace    String @default("")
  checkpointId String @map("checkpoint_id")
  taskId       String @map("task_id")
  taskPath     String @default("") @map("task_path")
  idx          Int
  channel      String
  valueType    String @map("value_type")
  value        Bytes

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, namespace, checkpointId, taskId, idx])
  @@index([workspaceId])
  @@map("agent_checkpoint_write")
}

model ToolCall {
  id             String         @id @default(uuid(7)) @db.Uuid
  workspaceId    String         @map("workspace_id") @db.Uuid
  runId          String         @map("run_id") @db.Uuid
  step           Int
  name           String
  args           Json
  status         ToolCallStatus
  resultSummary  String?        @map("result_summary")
  error          String?
  durationMs     Int            @map("duration_ms")
  idempotencyKey String         @unique @map("idempotency_key")
  createdAt      DateTime       @default(now()) @map("created_at")

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, step])
  @@index([workspaceId])
  @@map("tool_call")
}

// A change the agent proposed. Only ExecutionService carries it out, after the owner decides.
model PendingAction {
  id              String              @id @default(uuid(7)) @db.Uuid
  workspaceId     String              @map("workspace_id") @db.Uuid
  brandId         String              @map("brand_id") @db.Uuid
  runId           String              @map("run_id") @db.Uuid
  toolName        String              @map("tool_name")
  proposal        Json
  title           String
  summary         String
  changes         Json                @default("[]")
  credits         Int                 @default(0)
  status          PendingActionStatus @default(pending)
  decidedByUserId String?             @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime?           @map("decided_at")
  note            String?
  result          Json?
  undo            Json?
  idempotencyKey  String              @unique @map("idempotency_key")
  createdAt       DateTime            @default(now()) @map("created_at")

  brand Brand    @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  run   AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([workspaceId, status])
  @@map("pending_action")
}
