enum OnboardingStatus {
  in_progress
  completed
  abandoned
}

enum ScanStatus {
  queued
  running
  completed
  partial
  failed
  cancelled
}

model OnboardingSession {
  id             String           @id @default(uuid(7)) @db.Uuid
  workspaceId    String           @map("workspace_id") @db.Uuid
  brandId        String           @map("brand_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  track          AccountType
  status         OnboardingStatus @default(in_progress)
  currentStep    String           @map("current_step")
  completedSteps String[]         @default([]) @map("completed_steps")
  answers        Json             @default("{}")
  completedAt    DateTime?        @map("completed_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([brandId, status])
  @@index([workspaceId])
  @@map("onboarding_session")
}

model WebsiteScan {
  id              String     @id @default(uuid(7)) @db.Uuid
  workspaceId     String     @map("workspace_id") @db.Uuid
  brandId         String     @map("brand_id") @db.Uuid
  sourceId        String?    @map("source_id") @db.Uuid
  requestedUrl    String     @map("requested_url")
  normalizedUrl   String     @map("normalized_url")
  platform        String?
  status          ScanStatus @default(queued)
  idempotencyKey  String     @map("idempotency_key")
  pagesDiscovered Int        @default(0) @map("pages_discovered")
  pagesFetched    Int        @default(0) @map("pages_fetched")
  pagesFailed     Int        @default(0) @map("pages_failed")
  errorCode       String?    @map("error_code")
  errorMessage    String?    @map("error_message")
  config          Json       @default("{}")
  completeness    Json       @default("{}")
  startedAt       DateTime?  @map("started_at")
  finishedAt      DateTime?  @map("finished_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  brand     Brand               @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  source    KnowledgeSource?    @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  documents KnowledgeDocument[]

  @@unique([brandId, idempotencyKey])
  @@index([brandId, createdAt(sort: Desc)])
  @@index([workspaceId])
  @@map("website_scan")
}
