// Verified business entities (structured memory). Each row carries the shared
// provenance fields: source_type, source_url, source_trust, status,
// extraction_id, content_hash, extracted_at, verified_at, verified_by_user_id.
// Prices are integer minor units (paise).

enum Availability {
  in_stock
  out_of_stock
  preorder
  unknown
}

enum PolicyKind {
  return_policy
  refund
  shipping
  cancellation
  warranty
  privacy
  terms
  other
}

enum AudienceKind {
  primary
  secondary
  persona
}

enum SocialProvider {
  instagram
  facebook
  whatsapp
  youtube
  linkedin
  tiktok
  pinterest
  x
}

enum SocialConnectionStatus {
  url_only
  connected
  expired
  revoked
}

model BrandProduct {
  id             String       @id @default(uuid(7)) @db.Uuid
  workspaceId    String       @map("workspace_id") @db.Uuid
  brandId        String       @map("brand_id") @db.Uuid
  externalId     String?      @map("external_id")
  canonicalUrl   String?      @map("canonical_url")
  name           String
  description    String?
  category       String?
  sku            String?
  priceMinor     Int?         @map("price_minor")
  compareAtMinor Int?         @map("compare_at_minor")
  currency       String       @default("INR")
  availability   Availability @default(unknown)
  imageUrls      String[]     @default([]) @map("image_urls")
  tags           String[]     @default([])
  variants       Json         @default("[]")
  attributes     Json         @default("{}")

  sourceType       SourceType   @map("source_type")
  sourceUrl        String?      @map("source_url")
  sourceTrust      Float        @default(0) @map("source_trust") @db.Real
  status           RecordStatus @default(candidate)
  extractionId     String?      @map("extraction_id") @db.Uuid
  contentHash      String?      @map("content_hash")
  extractedAt      DateTime?    @map("extracted_at")
  verifiedAt       DateTime?    @map("verified_at")
  verifiedByUserId String?      @map("verified_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([brandId, externalId])
  @@index([brandId, status])
  @@index([brandId, canonicalUrl])
  @@index([workspaceId])
  @@map("brand_product")
}

model BrandService {
  id              String   @id @default(uuid(7)) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  brandId         String   @map("brand_id") @db.Uuid
  canonicalUrl    String?  @map("canonical_url")
  name            String
  description     String?
  priceMinor      Int?     @map("price_minor")
  currency        String   @default("INR")
  durationMinutes Int?     @map("duration_minutes")
  benefits        String[] @default([])
  bookingProcess  String?  @map("booking_process")
  attributes      Json     @default("{}")

  sourceType       SourceType   @map("source_type")
  sourceUrl        String?      @map("source_url")
  sourceTrust      Float        @default(0) @map("source_trust") @db.Real
  status           RecordStatus @default(candidate)
  extractionId     String?      @map("extraction_id") @db.Uuid
  contentHash      String?      @map("content_hash")
  extractedAt      DateTime?    @map("extracted_at")
  verifiedAt       DateTime?    @map("verified_at")
  verifiedByUserId String?      @map("verified_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  brand Brand @relation(fields: [brandId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([brandId, status])
  @@index([workspaceId])
  @@map("brand_service")
}

