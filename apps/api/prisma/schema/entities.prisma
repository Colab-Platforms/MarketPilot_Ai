  name        String
  description String?
  ageRange    String?      @map("age_range")
  locations   String[]     @default([])
  interests   String[]     @default([])
  painPoints  String[]     @default([]) @map("pain_points")
  attributes  Json         @default("{}")

  sourceType       SourceType   @map("source_type")
  sourceUrl        String?      @map("source_url")
  sourceTrust      Float        @default(0) @map("source_trust") @db.Real
  status           RecordStatus @default(candidate)
  extractionId     String?      @map("extraction_id") @db.Uuid
  contentHash      String?      @map("content_hash")
  extractedAt      DateTime?    @map("extracted_at")
  verifiedAt       DateTime?    @map("verified_at")
  verifiedByUserId String?      @map("verified_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

