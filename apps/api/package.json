{
  "name": "@marketpilot/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "prisma": "prisma"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@langchain/core": "1.4.1",
    "@langchain/langgraph": "1.7.4",
    "@langchain/langgraph-checkpoint": "1.2.3",
    "@marketpilot/contracts": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.2.1",
    "argon2": "^0.45.2",
    "bullmq": "^5.34.0",
    "cheerio": "1.0.0",
    "cookie-parser": "^1.4.7",
    "ioredis": "^5.4.2",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
